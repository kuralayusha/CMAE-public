{
  "name": "cmae",
  "version": "0.1.6",
  "private": true,
  "description": "CMAE — Cold Mail AI Engine (desktop)",
  "author": "CMAE",
  "main": "desktop/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/kuralayusha/CMAE.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx scripts/migrate.ts",
    "test:ai-usage": "node --conditions=react-server --import tsx --test test/ai-usage/ai-usage.test.ts",
    "test:tracker-state": "node --conditions=react-server --import tsx --test test/tracker-state/*.test.ts",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "desktop:obfuscate": "node scripts/obfuscate-desktop.mjs",
    "version:sync-policy": "node scripts/bump-version-policy.mjs",
    "desktop:prepare": "node scripts/obfuscate-desktop.mjs && node scripts/prepare-desktop.mjs",
    "desktop:build:mac": "node scripts/desktop-build-mac.mjs",
    "desktop:build:mac:signed": "node scripts/desktop-build-mac.mjs --sign",
    "desktop:build:win": "node scripts/desktop-build-win.mjs",
    "desktop:upload:github": "node scripts/upload-desktop-github.mjs",
    "desktop:publish:mac": "node scripts/desktop-build-mac.mjs && node scripts/upload-desktop-github.mjs --platform mac",
    "desktop:publish:mac:signed": "node scripts/desktop-build-mac.mjs --sign && node scripts/upload-desktop-github.mjs --platform mac",
    "desktop:publish:win": "node scripts/desktop-build-win.mjs --upload"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "drizzle-orm": "^0.45.4",
    "electron-updater": "^6.8.9",
    "iconv-lite": "^0.6.3",
    "imapflow": "^2.4.0",
    "next": "16.4.2",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.1.0",
    "pdf-parse": "^2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "sanitize-html": "^2.18.0",
    "server-only": "^0.0.1",
    "slugify": "^1.6.9",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@electron/notarize": "^2.5.0",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "electron": "^39.2.7",
    "electron-builder": "^26.17.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "javascript-obfuscator": "^4.2.2",
    "playwright": "^1.64.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true,
    "electron@39.2.7": true,
    "electron-winstaller@5.4.0": true
  }
}
