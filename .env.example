# AES-256 master key (at least 16 characters)
CMAE_MASTER_KEY=change-me-to-a-long-random-secret

# OpenRouter (can also be set in Settings UI). On the Vercel translation host this
# is the admin key that pays for language packs.
OPENROUTER_API_KEY=

# Vercel translation host only: pin the models (defaults in lib/llm/slots.ts).
# CMAE_I18N_MODEL=
# CMAE_LLM_MODEL_FAST=
# CMAE_LLM_MODEL_SMART=

# Locale translation host (desktop proxies here — OPENROUTER_API_KEY stays on server).
# Default: https://cmae.vercel.app
# Force local translate instead: CMAE_I18N_URL=local
# CMAE_I18N_URL=https://cmae.vercel.app

# Version policy host (desktop compares package.json vs remote).
# Default: same base as i18n → https://cmae.vercel.app/api/version
# Force bundled version-policy.json only: CMAE_VERSION_URL=local
# CMAE_VERSION_URL=https://cmae.vercel.app/api/version

# Optional: GitHub token for private-repo electron-updater checks
# CMAE_GH_TOKEN=

# Disable IMAP sync:
# CMAE_DISABLE_SYNC=1

# Anonymous usage telemetry (optional). Disabled unless you deploy the Edge
# Functions in supabase/functions to your own Supabase project and set these.
# The Edge Functions must enforce their own rate limits and payload caps.
# CMAE_USAGE_INGEST_URL=https://<your-project>.supabase.co/functions/v1/cmae-ingest
# CMAE_USAGE_PRICES_URL=https://<your-project>.supabase.co/functions/v1/cmae-prices
# Publishable (anon) key, optional
# CMAE_USAGE_ANON_KEY=

# Admin usage report (optional; /usage page)
# CMAE_USAGE_REPORT_URL=https://<your-project>.supabase.co/functions/v1/cmae-report
# CMAE_USAGE_REPORT_SECRET=
