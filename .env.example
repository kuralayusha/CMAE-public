# AES-256 master key (at least 16 characters)
CMAE_MASTER_KEY=change-me-to-a-long-random-secret

# Cursor SDK (can also be set in Settings UI)
CURSOR_API_KEY=

# Remote locale translation host (desktop/local proxies here).
# Default: https://cmae.vercel.app
# Set to "local" to translate with this machine's CURSOR_API_KEY instead.
# CMAE_I18N_URL=https://cmae.vercel.app
# NEXT_PUBLIC_CMAE_I18N_URL=https://cmae.vercel.app

# Disable IMAP sync:
# CMAE_DISABLE_SYNC=1
